["1/3 + 1/6 = ?",["1/2","2/3","1/9","1/6"],0],
["0,2 kasr ko‘rinishida?",["1/2","1/5","2/5","1/4"],1],
["Uchburchak yuzi formulasi?",["a×b","a×h/2","2a+2b","a+b"],1],
["x² - 9 = 0 tenglama ildizlari?",["3","-3","±3","9"],2],
["2, 4, 8, 16, keyingi son?",["20","24","30","32"],3],
["(x+2)(x-2) nimaga teng?",["x²+4","x²-4","x²-2","x²+2"],1],
["sin 30° qiymati?",["0","1","1/2","√3/2"],2]
]
};

const initial={
name:"Sayohatchi",xp:0,correct:0,tests:0,daily:0,
subjects:Object.keys(defaultData),
questions:{},mistakes:[],
tasks:[
{name:"Bugun 5 ta test ishlash",done:false,xp:20},
{name:"Bitta yangi mavzu o‘rganish",done:false,xp:15},
{name:"Xatolarni qayta ko‘rib chiqish",done:false,xp:10}
]
};

let data;
try{
data=JSON.parse(localStorage.getItem("lifeMapFull"))||initial;
}catch(e){data=initial}
if(!data.questions)data.questions={};
if(!data.mistakes)data.mistakes=[];
if(!data.tasks)data.tasks=initial.tasks;
if(!data.subjects)data.subjects=initial.subjects;
if(data.daily===undefined)data.daily=0;
if(data.correct===undefined)data.correct=0;
if(data.tests===undefined)data.tests=0;
if(data.xp===undefined)data.xp=0;
if(!data.name)data.name="Sayohatchi";

Object.keys(defaultData).forEach(s=>{
if(!data.questions[s]||data.questions[s].length<30)
data.questions[s]=defaultData[s];
});

let quiz=[],qIndex=0,score=0,answered=false,timer=null,timeLeft=20;
let memoryCards=[],memoryOpen=[],memoryMatches=0;

function save(){
localStorage.setItem("lifeMapFull",JSON.stringify(data));
render();
}

function level(){return Math.floor(data.xp/100)+1}

function showPage(id){
document.querySelectorAll("main section").forEach(s=>s.classList.remove("active"));
document.getElementById(id).classList.add("active");
render();
}

function saveName(){
let n=document.getElementById("nameInput").value.trim();
if(n)data.name=n;
save();
}

function render(){
document.getElementById("userLabel").textContent="Salom, "+data.name+"!";
document.getElementById("xp").textContent=data.xp;
document.getElementById("level").textContent=level();
document.getElementById("lessonCount").textContent=data.subjects.length;
document.getElementById("correctCount").textContent=data.correct;
document.getElementById("profileName").textContent=data.name;
document.getElementById("profileXP").textContent=data.xp;
document.getElementById("profileLevel").textContent=level();
document.getElementById("profileCorrect").textContent=data.correct;
document.getElementById("profileTests").textContent=data.tests;
document.getElementById("levelBar").style.width=(data.xp%100)+"%";
document.getElementById("levelText").textContent="Keyingi darajagacha: "+(100-data.xp%100)+" XP";
document.getElementById("dailyStatus").textContent=data.daily>=5?"✅ Kunlik challenge bajarildi!":"Bajarilgan: "+data.daily+"/5";
renderSubjects();
renderSelect();
renderTasks();
renderMistakes();
}

function renderSubjects(){
let box=document.getElementById("subjectList");
box.innerHTML="";
data.subjects.forEach((s,i)=>{
let d=document.createElement("div");
d.className="subject";
d.innerHTML='<div class="planet"></div><h3></h3><p class="muted"></p><button>Darsni ochish</button>';
d.querySelector("h3").textContent=s;
d.querySelector("p").textContent=(data.questions[s]||[]).length+" ta savol";
d.querySelector("button").onclick=()=>openLesson(s);
box.appendChild(d);
});
}

function renderSelect(){
let el=document.getElementById("quizSubject");
let old=el.value;
el.innerHTML="";
data.subjects.forEach(s=>{
let o=document.createElement("option");
o.value=s;o.textContent=s;el.appendChild(o);
});
if(data.subjects.includes(old))el.value=old;
}

function addSubject(){
let s=document.getElementById("newSubject").value.trim();
if(!s)return alert("Fan nomini kiriting!");
if(data.subjects.includes(s))return alert("Bu fan mavjud!");
data.subjects.push(s);
data.questions[s]=[];
document.getElementById("newSubject").value="";
save();
openLesson(s);
}

function openLesson(s){
let box=document.getElementById("lessonDetails");
box.innerHTML="";
let h=document.createElement("h2");h.textContent="📘 "+s;
let p=document.createElement("p");p.textContent="Bu fan bo‘yicha savollar: "+data.questions[s].length;
let btn=document.createElement("button");btn.textContent="Testni boshlash";
btn.onclick=()=>{document.getElementById("quizSubject").value=s;showPage("quiz")};
let h3=document.createElement("h3");h3.textContent="O‘z savolingizni qo‘shish";
let input=document.createElement("input");input.placeholder="Savol matni";
let opts=[];
for(let i=0;i<4;i++){
let inp=document.createElement("input");
inp.placeholder="Javob "+(i+1);
opts.push(inp);
box.appendChild(inp);
}
let sel=document.createElement("select");
["Oson","O‘rtacha","Qiyin"].forEach((x,i)=>{
let o=document.createElement("option");o.value=i;o.textContent=x;sel.appendChild(o);
});
let correct=document.createElement("select");
for(let i=0;i<4;i++){
let o=document.createElement("option");o.value=i;o.textContent="To‘g‘ri javob: "+(i+1);correct.appendChild(o);
}
let add=document.createElement("button");add.textContent="Savolni saqlash";
add.onclick=()=>{
let q=input.value.trim(),a=opts.map(x=>x.value.trim());
if(!q||a.some(x=>!x))return alert("Savol va 4 ta javobni to‘ldiring!");
data.questions[s].push({q,a,c:Number(correct.value),d:Number(sel.value)});
save();openLesson(s);
};
box.append(h,p,btn,h3,input,sel,correct,add);
}

function getQuestion(q,index){
if(Array.isArray(q))return {q:q[0],a:q[1],c:q[2],d:index<10?0:index<20?1:2};
return q;
}

function startQuiz(){
let s=document.getElementById("quizSubject").value;textContent="📚 Fan: "+m.subject;
let q=document.createElement("p");
q.textContent="❓ Savol: "+m.q;
let c=document.createElement("p");
c.textContent="✅ To‘g‘ri javob: "+m.correct;
let y=document.createElement("p");
y.textContent="❌ Sizning javobingiz: "+m.your;
let d=document.createElement("div");
d.className="card";
d.append(q,c,y);
box.appendChild(d);
});
}

function clearMistakes(){
if(!confirm("Barcha xatolarni o‘chirmoqchimisiz?"))return;
data.mistakes=[];
save();
}

function bossChallenge(){
if(level()<5){
document.getElementById("bossStatus").textContent=
"🔒 Boss sinovi 5-darajadan boshlab ochiladi. Hozirgi darajangiz: "+level();
return;
}
let questions=[
["HTML nimani anglatadi?",["Dasturlash tili","Belgilash tili","Operatsion tizim","Brauzer"],1],
["CSS nima uchun ishlatiladi?",["Dizayn uchun","Hisoblash uchun","Ma'lumot saqlash uchun","Internet uchun"],0],
["JavaScript nima qiladi?",["Faqat rasm chizadi","Saytga interaktivlik qo‘shadi","Faqat matn yozadi","Fayl o‘chiradi"],1],
["Python bu nima?",["Dasturlash tili","Telefon","Brauzer","O‘yin"],0],
["HTML fayl kengaytmasi qaysi?",[".jpg",".mp3",".html",".pdf"],2]
];

let correct=0;
let index=0;
let box=document.getElementById("quizArea");
showPage("quiz");

function ask(){
if(index>=questions.length){
let reward=correct*20;
data.xp+=reward;
save();
box.innerHTML="<h2>👑 Boss sinovi tugadi!</h2><p>Natija: "+correct+"/5</p><p>Yutuq: "+reward+" XP</p>";
document.getElementById("bossStatus").textContent="Boss sinovi yakunlandi!";
return;
}
let q=questions[index];
box.innerHTML="<h3>👑 Boss savoli "+(index+1)+"/5</h3><p>"+q[0]+"</p>";
q[1].forEach((a,i)=>{
let b=document.createElement("button");
b.className="option";
b.textContent=a;
b.onclick=()=>{
if(i===q[2])correct++;
index++;
ask();
};
box.appendChild(b);
});
}
ask();
}

function startMemory(){
let icons=["🚀","🌍","⭐","🌙","🪐","☄️","🌟","🛸"];
memoryCards=[...icons,...icons].sort(()=>Math.random()-0.5);
memoryOpen=[];
memoryMatches=0;

let box=document.getElementById("memory");
box.innerHTML="";
memoryCards.forEach((icon,i)=>{
let b=document.createElement("button");
b.textContent="❔";
b.dataset.index=i;
b.onclick=()=>flipCard(i,b);
box.appendChild(b);
});
document.getElementById("memoryStatus").textContent="Bir xil belgilarni toping!";
}

function flipCard(i,b){
if(memoryOpen.length===2||b.textContent!=="❔")return;
b.textContent=memoryCards[i];
memoryOpen.push({i,b});

if(memoryOpen.length===2){
let [a,c]=memoryOpen;
if(memoryCards[a.i]===memoryCards[c.i]){
memoryMatches++;
memoryOpen=[];
if(memoryMatches===8){
data.xp+=30;
save();
document.getElementById("memoryStatus").textContent="🎉 G‘alaba! +30 XP";
}else{
document.getElementById("memoryStatus").textContent="✅ To‘g‘ri juftlik!";
}
}else{
setTimeout(()=>{
a.b.textContent="❔";
c.b.textContent="❔";
memoryOpen=[];
},800);
}
}
}

function resetData(){
if(!confirm("Barcha natijalar o‘chirilsinmi?"))return;
localStorage.removeItem("lifeMapFull");
location.reload();
}

render();
startMemory();
</script>
</body>
</html>
