q.textContent="❓ Savol: "+m.q;
let c=document.createElement("p");
c.textContent="✅ To‘g‘ri javob: "+m.correct;
let y=document.createElement("p");
y.textContent="❌ Sizning javobingiz: "+m.your;
let d=document.createElement("div");
d.className="card";

d.append(q,c,y);
box.appendChild(d);
});
}

function clearMistakes(){
if(!confirm("Barcha xatolarni o‘chirmoqchimisiz?"))return;
data.mistakes=[];
save();
}

function bossChallenge(){
if(level()<5){
document.getElementById("bossStatus").textContent=
"🔒 Boss sinovi 5-darajadan boshlab ochiladi. Hozirgi darajangiz: "+level();
return;
}

let questions=[
["HTML nimani anglatadi?",["Dasturlash tili","Belgilash tili","Operatsion tizim","Brauzer"],1],
["CSS nima uchun ishlatiladi?",["Dizayn uchun","Hisoblash uchun","Ma'lumot saqlash uchun","Internet uchun"],0],
["JavaScript nima qiladi?",["Faqat rasm chizadi","Saytga interaktivlik qo‘shadi","Faqat matn yozadi","Fayl o‘chiradi"],1],
["Python bu nima?",["Dasturlash tili","Telefon","Brauzer","O‘yin"],0],
["HTML fayl kengaytmasi qaysi?",[".jpg",".mp3",".html",".pdf"],2]
];

let correct=0;
let index=0;
let box=document.getElementById("quizArea");
showPage("quiz");

function ask(){
if(index>=questions.length){
let reward=correct*20;
data.xp+=reward;
save();
box.innerHTML="<h2>👑 Boss sinovi tugadi!</h2><p>Natija: "+correct+"/5</p><p>Yutuq: "+reward+" XP</p>";
document.getElementById("bossStatus").textContent="Boss sinovi yakunlandi!";
return;
}

let q=questions[index];
box.innerHTML="<h3>👑 Boss savoli "+(index+1)+"/5</h3><p>"+q[0]+"</p>";

q[1].forEach((a,i)=>{
let b=document.createElement("button");
b.className="option";
b.textContent=a;
b.onclick=()=>{
if(i===q[2])correct++;
index++;
ask();
};
box.appendChild(b);
});
}
ask();
}

function startMemory(){
let icons=["🚀","🌍","⭐","🌙","🪐","☄️","🌟","🛸"];
memoryCards=[...icons,...icons].sort(()=>Math.random()-0.5);
memoryOpen=[];
memoryMatches=0;

let box=document.getElementById("memory");
box.innerHTML="";

memoryCards.forEach((icon,i)=>{
let b=document.createElement("button");
b.textContent="❔";
b.dataset.index=i;
b.onclick=()=>flipCard(i,b);
box.appendChild(b);
});

document.getElementById("memoryStatus").textContent="Bir xil belgilarni toping!";
}

function flipCard(i,b){
if(memoryOpen.length===2||b.textContent!=="❔")return;

b.textContent=memoryCards[i];
memoryOpen.push({i,b});

if(memoryOpen.length===2){
let [a,c]=memoryOpen;

if(memoryCards[a.i]===memoryCards[c.i]){
memoryMatches++;
memoryOpen=[];

if(memoryMatches===8){
data.xp+=30;
save();
document.getElementById("memoryStatus").textContent="🎉 G‘alaba! +30 XP";
}else{
document.getElementById("memoryStatus").textContent="✅ To‘g‘ri juftlik!";
}
}else{
setTimeout(()=>{
a.b.textContent="❔";
c.b.textContent="❔";
memoryOpen=[];
},800);
}
}
}

function resetData(){
if(!confirm("Barcha natijalar o‘chirilsinmi?"))return;
localStorage.removeItem("lifeMapFull");
location.reload();
}

render();
startMemory();
</script>
</body>
</html>



















































