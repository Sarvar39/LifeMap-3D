!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LifeMap 3D</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d1c;color:#f4f6ff;font-family:Arial,sans-serif}
header{padding:18px;background:#111a32;text-align:center}
.logo{font-size:25px;font-weight:bold;color:#72e5ff}
nav{display:flex;gap:6px;overflow-x:auto;padding:10px;background:#111a32}
button,select,input{padding:11px;border:0;border-radius:9px;font-size:15px}
button{background:#596cff;color:white;cursor:pointer;margin:3px}
button:hover{filter:brightness(1.15)}
button:disabled{opacity:.5}
nav button{white-space:nowrap;background:#202d4b}
main{max-width:900px;margin:auto;padding:14px}
section{display:none}
section.active{display:block}
.card{background:#141f38;border:1px solid #293958;border-radius:15px;padding:16px;margin:12px 0}
h2{color:#78e5ff}
h3{margin-bottom:6px}
.muted{color:#aab8d3}
.small{font-size:13px}
input,select{background:#263756;color:white;width:100%;margin:5px 0}
.stat{background:#1c2b4a;padding:12px;border-radius:12px;text-align:center}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.stat b{display:block;font-size:24px;color:#78e5ff}
.planet{width:85px;height:85px;border-radius:50%;margin:10px auto;background:radial-gradient(circle at 30% 30%,#a7f5ff,#4b62dd,#151b5a);box-shadow:0 0 25px #536cff}
.subjects{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.subject{background:#1b2947;border-radius:15px;padding:12px;text-align:center}
.subject button{width:100%}
.progress{height:10px;background:#293958;border-radius:20px;overflow:hidden}
.progress div{height:100%;background:linear-gradient(90deg,#596cff,#72e5ff)}
.option{display:block;width:100%;text-align:left;margin:7px 0;background:#263756}
.option.correct{background:#167d62}
.option.wrong{background:#a83d52}
.task{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:9px;border-bottom:1px solid #293958}
#memory{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
#memory button{font-size:25px;min-height:65px}
footer{text-align:center;color:#8494b3;padding:20px}
</style>
</head>
<body>

<header>
<div class="logo">🌌 LifeMap 3D</div>
<div id="userLabel">Salom, sayohatchi!</div>
</header>

<nav>
<button onclick="showPage('home')">🏠 Bosh sahifa</button>
<button onclick="showPage('lessons')">📚 Darslar</button>
<button onclick="showPage('quiz')">📝 Test</button>
<button onclick="showPage('games')">🎮 O‘yinlar</button>
<button onclick="showPage('tasks')">🎯 Vazifalar</button>
<button onclick="showPage('mistakes')">📖 Xatolar</button>
<button onclick="showPage('profile')">👤 Profil</button>
</nav>

<main>

<section id="home" class="active">
<div class="card" style="text-align:center">
<div class="planet"></div>
<h2>Bilim olamiga xush kelibsiz!</h2>
<p class="muted">Har bir dars — yangi sayyora.</p>
<input id="nameInput" placeholder="Ismingizni kiriting">
<button onclick="saveName()">Boshlash 🚀</button>
</div>

<div class="stats">
<div class="stat">⭐ XP<b id="xp">0</b></div>
<div class="stat">🏆 Daraja<b id="level">1</b></div>
<div class="stat">📚 Darslar<b id="lessonCount">3</b></div>
<div class="stat">✅ To‘g‘ri javoblar<b id="correctCount">0</b></div>
</div>

<div class="card">
<h2>🌠 Daraja rivojlanishi</h2>
<div class="progress"><div id="levelBar" style="width:0%"></div></div>
<p id="levelText" class="muted">Keyingi darajaga intiling!</p>
</div>

<div class="card">
<h2>🔥 Kunlik challenge</h2>
<p>Bugun kamida 5 ta test savoliga javob bering.</p>
<p id="dailyStatus">Hali bajarilmadi</p>
<button onclick="showPage('quiz')">Test boshlash</button>
</div>
</section>

<section id="lessons">
<h2>📚 Mening sayyoralarim</h2>
<div id="subjectList" class="subjects"></div>
<div class="card">
<h3>➕ Yangi fan qo‘shish</h3>
<input id="newSubject" placeholder="Masalan: Tarix">
<button onclick="addSubject()">Fan qo‘shish</button>
</div>
<div class="card" id="lessonDetails">
<p class="muted">Darsni tanlang.</p>
</div>
</section>

<section id="quiz">
<h2>📝 Bilim sinovi</h2>
<div class="card">
<label>Fan:</label>
<select id="quizSubject"></select>
<p class="muted">Har bir fandan 30 ta savol.</p>
<p>1–10: Oson | 11–20: O‘rtacha | 21–30: Qiyin</p>
<button onclick="startQuiz()">30 talik testni boshlash 🚀</button>
</div>
<div class="card" id="quizArea">
<p class="muted">Testni boshlash uchun yuqoridagi tugmani bosing.</p>
</div>
</section>

<section id="games">
<h2>🎮 Bilim o‘yinlari</h2>
<div class="card">
<h3>🧠 Xotira o‘yini</h3>
<p>Bir xil belgilarni toping.</p>
<div id="memory"></div>
<p id="memoryStatus"></p>
<button onclick="startMemory()">Yangi o‘yin</button>
</div>
<div class="card">
<h3>👑 Boss Challenge</h3>
<p>5-darajaga yetganingizda maxsus sinov ochiladi.</p>
<button onclick="bossChallenge()">Boss sinovini boshlash</button>
<p id="bossStatus" class="muted"></p>
</div>
</section>

<section id="tasks">
<h2>🎯 Vazifalar</h2>
<div class="card" id="taskList"></div>
<div class="card">
<h3>O‘zingizning vazifangiz</h3>
<input id="taskInput" placeholder="Vazifa nomi">
<button onclick="addTask()">Qo‘shish</button>
</div>
</section>

<section id="mistakes">
<h2>📖 Xatolar daftari</h2>
<div class="card" id="mistakeList">Hozircha xatolar yo‘q.</div>
<button onclick="clearMistakes()">Xatolarni tozalash</button>
</section>

<section id="profile">
<h2>👤 Mening profilim</h2>
<div class="card">
<h3 id="profileName">Sayohatchi</h3>
<p>⭐ Jami XP: <b id="profileXP">0</b></p>
<p>🏆 Daraja: <b id="profileLevel">1</b></p>
<p>✅ To‘g‘ri javoblar: <b id="profileCorrect">0</b></p>
<p>📝 Ishlangan testlar: <b id="profileTests">0</b></p>
<button onclick="resetData()">Barcha natijalarni o‘chirish</button>
</div>
</section>

</main>
<footer>LifeMap 3D © 2026 — Bilim bilan yangi olam sari!</footer>

<script>
